# Local personal development only. Never put this file with real values in an APK or commit .env.
AI_ENABLED=false
OPENAI_API_KEY=
# A documented example, not a claim that this model was tested with a real key here.
OPENAI_MODEL=gpt-5.4-mini
# Optional; choose an effort supported by your selected model.
OPENAI_REASONING_EFFORT=none
AI_DAILY_LIMIT=20
AI_PER_MINUTE=5
AI_TIMEOUT_MS=35000
AI_MAX_OUTPUT_TOKENS=3000
PORT=4173
# Optional 32+ character random PERSONAL backend token; generated locally if blank/omitted.
APP_ACCESS_TOKEN=
